{
  "name": "sla-tracker-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "start": "node server/src/server.js",
    "dev": "node scripts/start-all.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test:server": "npm --prefix server test",
    "tunnel": "npx localtunnel --port 5000"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
